#!/bin/sh
# Runs as root after the package is installed or upgraded.
set -e

NAME=io.github.afsartanvir.ClipboardLinux

# Runs a command as user $1 against that user's own session bus, so systemd
# and D-Bus calls reach their desktop session rather than root's.
as_user() {
    user=$1
    shift
    uid=$(id -u "$user")
    runuser -u "$user" -- env XDG_RUNTIME_DIR="/run/user/$uid" \
        DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" "$@"
}

# Starts the app (restarting an older version after an upgrade) for every
# user logged in to a desktop right now. Later logins start it from
# /etc/xdg/autostart.
start_for_logged_in_users() {
    command -v loginctl >/dev/null 2>&1 || return 0
    command -v systemd-run >/dev/null 2>&1 || return 0

    for uid in $(loginctl list-users --no-legend 2>/dev/null | awk '{print $1}'); do
        [ "$uid" -ge 1000 ] 2>/dev/null || continue
        [ -S "/run/user/$uid/bus" ] || continue
        user=$(id -nu "$uid" 2>/dev/null) || continue

        # Only desktop sessions: their session manager knows the display.
        as_user "$user" systemctl --user show-environment 2>/dev/null \
            | grep -qE '^(DISPLAY|WAYLAND_DISPLAY)=' || continue

        # A running older version keeps the D-Bus name and would make the new
        # one exit at once, so ask it to quit and wait up to 5 seconds.
        as_user "$user" gdbus call --session --timeout 2 --dest "$NAME" \
            --object-path /ClipboardLinux --method "$NAME.Quit" >/dev/null 2>&1 || true
        i=0
        while [ "$i" -lt 25 ] && as_user "$user" gdbus call --session --timeout 1 \
                --dest org.freedesktop.DBus --object-path /org/freedesktop/DBus \
                --method org.freedesktop.DBus.NameHasOwner "$NAME" 2>/dev/null | grep -q true; do
            sleep 0.2
            i=$((i + 1))
        done

        # Through the user's session manager: it runs in the background with
        # the desktop's environment, independent of this terminal.
        if as_user "$user" systemd-run --user --collect --quiet /usr/bin/clipboard-linux; then
            echo "clipboard-linux is running for $user."
        else
            echo "Could not start clipboard-linux for $user now; it starts at the next login."
        fi
    done
}

if [ "$1" = "configure" ]; then
    # Load uinput now (modules-load.d does it on later boots) and apply the
    # udev rule so the logged-in user can paste without rebooting.
    modprobe uinput 2>/dev/null || true
    if command -v udevadm >/dev/null 2>&1; then
        udevadm control --reload-rules || true
        udevadm trigger --name-match=uinput || true
    fi

    start_for_logged_in_users || true

    cat <<'MSG'

clipboard-linux is installed and starts automatically every time you log in.
  Copy some text, then press Super+V to see your history.
  Ctrl+Alt+1..9 pastes item 1..9 directly.

MSG
fi

exit 0
